<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.ally.blogapp.controller.DashboardController"
            prefWidth="1100" prefHeight="700"
            style="-fx-background-color: white;">

    <!-- Sidebar -->
    <left>
        <VBox fx:id="sidebar" prefWidth="220" spacing="5"
              style="-fx-background-color: black; -fx-padding: 0;">

            <!-- App header -->
            <VBox alignment="CENTER" spacing="3" style="-fx-padding: 25 20 20 20;">
                <Label text="BlogApp" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label fx:id="userLabel" style="-fx-font-size: 13px; -fx-text-fill: #ccc;"/>
                <Label fx:id="roleLabel" style="-fx-font-size: 11px; -fx-text-fill: #999;"/>
            </VBox>

            <Separator style="-fx-background-color: #333;"/>

            <VBox spacing="3" style="-fx-padding: 15 10;">
                <Button text="All Posts" onAction="#showAllPosts" prefWidth="200"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15; -fx-background-radius: 4; -fx-cursor: hand;"/>
                <Button text="My Posts" onAction="#showMyPosts" prefWidth="200"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15; -fx-background-radius: 4; -fx-cursor: hand;"/>
                <Button fx:id="createPostBtn" text="Create Post" onAction="#showCreatePost" prefWidth="200"
                        style="-fx-background-color: white; -fx-text-fill: black; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15; -fx-background-radius: 4; -fx-cursor: hand;"/>
            </VBox>

            <!-- Spacer -->
            <Region VBox.vgrow="ALWAYS"/>

            <VBox style="-fx-padding: 10;">
                <Button text="Logout" onAction="#handleLogout" prefWidth="200"
                        style="-fx-background-color: #333; -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 10 15; -fx-background-radius: 4; -fx-cursor: hand;"/>
            </VBox>
        </VBox>
    </left>

    <!-- Center content loaded dynamically -->
    <center>
        <VBox alignment="CENTER" spacing="10">
            <Label text="Welcome to BlogApp!" style="-fx-font-size: 20px; -fx-text-fill: #999;"/>
        </VBox>
    </center>
</BorderPane>
