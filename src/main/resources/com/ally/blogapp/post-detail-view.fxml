<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.ally.blogapp.controller.PostDetailController"
      spacing="15" style="-fx-padding: 25; -fx-background-color: white;">

    <!-- Back button -->
    <Button text="Back to Posts" onAction="#handleBack"
            style="-fx-background-color: white; -fx-text-fill: black; -fx-padding: 8 16; -fx-border-color: black; -fx-border-width: 1; -fx-border-radius: 3; -fx-background-radius: 3; -fx-cursor: hand;"/>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background: white; -fx-background-color: white; -fx-border-color: transparent;">
        <VBox spacing="20">
            <padding><Insets right="5"/></padding>

            <!-- Post Content Card -->
            <VBox spacing="12" style="-fx-background-color: white; -fx-padding: 25; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-border-radius: 4;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label fx:id="statusLabel"/>
                    <Label fx:id="avgRatingLabel" style="-fx-font-size: 13px; -fx-text-fill: black; -fx-font-weight: bold;"/>
                </HBox>

                <Label fx:id="titleLabel" wrapText="true"
                       style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: black;"/>

                <HBox spacing="15">
                    <Label fx:id="authorLabel" style="-fx-font-size: 13px; -fx-text-fill: #999;"/>
                    <Label fx:id="dateLabel" style="-fx-font-size: 13px; -fx-text-fill: #999;"/>
                </HBox>

                <Label fx:id="tagsLabel" style="-fx-font-size: 12px; -fx-text-fill: #666; -fx-font-style: italic;"/>

                <Separator/>

                <Label fx:id="contentLabel" wrapText="true"
                       style="-fx-font-size: 14px; -fx-text-fill: #333; -fx-line-spacing: 4;"/>
            </VBox>

            <!-- Reviews Section -->
            <VBox spacing="12" style="-fx-background-color: white; -fx-padding: 20; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-border-radius: 4;">
                <Label text="Reviews" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: black;"/>

                <VBox fx:id="reviewsContainer" spacing="8"/>

                <!-- Review Form -->
                <VBox fx:id="reviewFormBox" spacing="10" style="-fx-padding: 10 0 0 0;">
                    <Separator/>
                    <Label text="Rate this post" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: black;"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Rating:" style="-fx-font-size: 13px;"/>
                        <ComboBox fx:id="ratingCombo"/>
                    </HBox>
                    <Label fx:id="reviewError" style="-fx-text-fill: black; -fx-font-size: 12px;"/>
                    <Button text="Submit Rating" onAction="#handleAddReview"
                            style="-fx-background-color: black; -fx-text-fill: white; -fx-padding: 8 20; -fx-background-radius: 3; -fx-cursor: hand;"/>
                </VBox>
            </VBox>

            <!-- Comments Section -->
            <VBox spacing="12" style="-fx-background-color: white; -fx-padding: 20; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-border-radius: 4;">
                <Label text="Comments" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: black;"/>

                <VBox fx:id="commentsContainer" spacing="8"/>

                <!-- Comment Form -->
                <VBox spacing="10" style="-fx-padding: 10 0 0 0;">
                    <Separator/>
                    <Label text="Add a Comment" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: black;"/>
                    <TextArea fx:id="commentInput" promptText="Write your comment..."
                              prefRowCount="3" wrapText="true"
                              style="-fx-border-color: #ddd; -fx-border-width: 1; -fx-border-radius: 3;"/>
                    <Label fx:id="commentError" style="-fx-text-fill: black; -fx-font-size: 12px;"/>
                    <Button text="Post Comment" onAction="#handleAddComment"
                            style="-fx-background-color: black; -fx-text-fill: white; -fx-padding: 8 20; -fx-background-radius: 3; -fx-cursor: hand;"/>
                </VBox>
            </VBox>
        </VBox>
    </ScrollPane>
</VBox>
