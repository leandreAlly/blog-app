<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.ally.blogapp.controller.LoginController"
           prefWidth="900" prefHeight="600"
           style="-fx-background-color: white;">

    <VBox alignment="CENTER" spacing="0" maxWidth="400">

        <!-- Login Pane -->
        <VBox fx:id="loginPane" alignment="CENTER" spacing="15"
              style="-fx-background-color: white; -fx-padding: 40; -fx-border-color: black; -fx-border-width: 1; -fx-border-radius: 4;">

            <Label text="BlogApp" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: black;"/>
            <Label text="Sign in to your account" style="-fx-font-size: 13px; -fx-text-fill: #666;"/>

            <TextField fx:id="loginUsername" promptText="Username"
                       style="-fx-padding: 10; -fx-border-color: black; -fx-border-width: 1; -fx-border-radius: 3; -fx-background-radius: 3;"/>
            <PasswordField fx:id="loginPassword" promptText="Password"
                           style="-fx-padding: 10; -fx-border-color: black; -fx-border-width: 1; -fx-border-radius: 3; -fx-background-radius: 3;"/>

            <Label fx:id="loginError" style="-fx-text-fill: black; -fx-font-size: 12px;"/>

            <Button text="Sign In" onAction="#handleLogin" prefWidth="320"
                    style="-fx-background-color: black; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10; -fx-background-radius: 3; -fx-cursor: hand;"/>

            <HBox alignment="CENTER" spacing="5">
                <Label text="Don't have an account?" style="-fx-text-fill: #666;"/>
                <Hyperlink text="Sign Up" onAction="#showRegister" style="-fx-text-fill: black; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>

        <!-- Register Pane -->
        <VBox fx:id="registerPane" alignment="CENTER" spacing="12" visible="false" managed="false"
              style="-fx-background-color: white; -fx-padding: 35; -fx-border-color: black; -fx-border-width: 1; -fx-border-radius: 4;">

            <Label text="BlogApp" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: black;"/>
            <Label text="Create a new account" style="-fx-font-size: 13px; -fx-text-fill: #666;"/>

            <TextField fx:id="regUsername" promptText="Username"
                       style="-fx-padding: 10; -fx-border-color: black; -fx-border-width: 1; -fx-border-radius: 3; -fx-background-radius: 3;"/>
            <TextField fx:id="regEmail" promptText="Email"
                       style="-fx-padding: 10; -fx-border-color: black; -fx-border-width: 1; -fx-border-radius: 3; -fx-background-radius: 3;"/>
            <PasswordField fx:id="regPassword" promptText="Password"
                           style="-fx-padding: 10; -fx-border-color: black; -fx-border-width: 1; -fx-border-radius: 3; -fx-background-radius: 3;"/>
            <PasswordField fx:id="regConfirmPassword" promptText="Confirm Password"
                           style="-fx-padding: 10; -fx-border-color: black; -fx-border-width: 1; -fx-border-radius: 3; -fx-background-radius: 3;"/>

            <ComboBox fx:id="regRole" prefWidth="320"
                      style="-fx-padding: 5; -fx-border-color: black; -fx-border-width: 1; -fx-border-radius: 3;"/>

            <Label fx:id="regError" style="-fx-text-fill: black; -fx-font-size: 12px;"/>

            <Button text="Sign Up" onAction="#handleRegister" prefWidth="320"
                    style="-fx-background-color: black; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10; -fx-background-radius: 3; -fx-cursor: hand;"/>

            <HBox alignment="CENTER" spacing="5">
                <Label text="Already have an account?" style="-fx-text-fill: #666;"/>
                <Hyperlink text="Sign In" onAction="#showLogin" style="-fx-text-fill: black; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </VBox>
</StackPane>
