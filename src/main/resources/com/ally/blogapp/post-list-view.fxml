<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.ally.blogapp.controller.PostListController"
      spacing="15" style="-fx-padding: 25; -fx-background-color: white;">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label fx:id="headerLabel" text="All Posts"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: black;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <TextField fx:id="searchField" promptText="Search by keyword..."
                   prefWidth="280"
                   style="-fx-padding: 8; -fx-border-color: black; -fx-border-width: 1; -fx-border-radius: 3; -fx-background-radius: 3;"/>
        <Button text="Search" onAction="#handleSearch"
                style="-fx-background-color: black; -fx-text-fill: white; -fx-padding: 8 16; -fx-background-radius: 3; -fx-cursor: hand;"/>
    </HBox>

    <!-- Post list -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background: white; -fx-background-color: white; -fx-border-color: transparent;">
        <VBox fx:id="postListContainer" spacing="12">
            <padding><Insets right="5"/></padding>
        </VBox>
    </ScrollPane>
</VBox>
